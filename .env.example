# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# MongoDB Connection URI (Atlas or Local)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/
MONGO_DB_NAME=dating_bot

# FastAPI Admin Server
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_API_KEY=change-me-to-a-secure-key

# Bot Pricing & Limits
FREE_LIKES_PER_DAY=20
FREE_VIEWS_PER_HOUR=10
PREMIUM_15D_STARS=100
PREMIUM_30D_STARS=200
